# ==============================================================================
# DETTY DECEMBER LAGOS LUXE - BACKEND PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env on your production server and fill in real production credentials.
# Any missing or default values will cause startup to abort if DJANGO_DEBUG=False.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-secure-random-50-character-secret-key-in-production
DJANGO_ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com
# Custom admin URL path in production (avoid default admin/ to prevent scanner attacks)
DJANGO_ADMIN_URL=admin/
# Optional: SSL Redirect & HSTS (enabled by default when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
DB_NAME=detty_luxe_db
DB_USER=detty_luxe_user
DB_PASSWORD=your_secure_postgres_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. FRONTEND & DOMAIN INTEGRATION
# ------------------------------------------------------------------------------
FRONTEND_BASE_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ------------------------------------------------------------------------------
# 4. PAYSTACK GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
# In production, use your live keys starting with pk_live_ and sk_live_
PAYSTACK_PUBLIC_KEY=pk_live_your_live_public_key_here
PAYSTACK_SECRET_KEY=sk_live_your_live_secret_key_here

# ------------------------------------------------------------------------------
# 5. FLUTTERWAVE GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
# In production, use your live keys starting with FLWPUBK- and FLWSECK-
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your_live_public_key_here
FLUTTERWAVE_SECRET_KEY=FLWSECK-your_live_secret_key_here
FLUTTERWAVE_ENCRYPTION=your_live_encryption_key_here
FLUTTERWAVE_SECRET_HASH=your_custom_secure_webhook_passphrase_here

# ------------------------------------------------------------------------------
# 6. RESERVATION SEAT HOLD TIMEOUT
# ------------------------------------------------------------------------------
BOOKING_HOLD_TIMEOUT_MINUTES=30

# ------------------------------------------------------------------------------
# 7. EMAIL NOTIFICATION CONFIGURATION
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email_app_user_here
EMAIL_HOST_PASSWORD=your_email_app_password_here
DEFAULT_FROM_EMAIL=
EMAIL_SENDER_NAME=
EMAIL_ENABLED=True
EMAIL_DEBUG=False
INTERNAL_NOTIFICATION_EMAILS=

# ------------------------------------------------------------------------------
# 8. CLOUDFLARE TURNSTILE CAPTCHA
# ------------------------------------------------------------------------------
# Cloudflare Turnstile secret key for server-side token verification
# Universal test key: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

